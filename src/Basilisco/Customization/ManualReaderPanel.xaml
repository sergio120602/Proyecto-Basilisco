<UserControl x:Class="Basilisco.Customization.ManualReaderPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:carousel="clr-namespace:Basilisco.Carousel"
             Focusable="True" FocusVisualStyle="{x:Null}" PreviewKeyDown="OnPreviewKeyDown" MouseWheel="OnMouseWheel">
    <!-- El manual abierto como un libro en 3D: dos páginas a la vez (la portada sola, a la derecha) y la hoja pasando -->
    <Grid Background="#F70B0D11">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Margin="56,34,56,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Formato: el libro abierto (libreta, de dos en dos) o una sola página, del tamaño de su imagen -->
                <ToggleButton x:Name="SinglePageToggle" Style="{StaticResource FilterToggle}" Content="Una sola página" Focusable="False"
                              VerticalAlignment="Center" Margin="0,0,10,0" Click="OnSinglePageClick"
                              ToolTip="Encendido: de página en página, cada una con su forma (las horizontales se ven enteras). Apagado: el libro abierto, en modo libreta (P)"/>
                <Button x:Name="PinterestButton" Style="{StaticResource PillButton}" Content="Hacer con Pinterest" Margin="0,0,10,0" Focusable="False"
                        Click="OnPinterestClick" ToolTip="Elige en Pinterest las imágenes del manual (las que ya tiene salen elegidas, para cambiarlas)"/>
                <Button x:Name="ExternalButton" Style="{StaticResource PillButton}" Content="Abrir en el visor de PDF" Click="OnOpenExternalClick"
                        ToolTip="Abre el manual con el programa de PDF de Windows (para imprimirlo, buscar o ampliar)"/>
                <Button Style="{StaticResource PillButton}" Content="Cerrar" Margin="10,0,0,0" Click="OnCloseClick"/>
            </StackPanel>
            <StackPanel>
                <TextBlock x:Name="TitleText" FontSize="28" FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="Manual de instrucciones" FontSize="14" Foreground="#A9B1BD" Margin="2,4,0,0"/>
            </StackPanel>
        </DockPanel>

        <!-- El libro en 3D: un clic en la mitad derecha pasa página; en la izquierda, vuelve -->
        <Grid Grid.Row="1" Margin="40,8,40,8">
            <carousel:BookView x:Name="Book" Cursor="Hand" Background="Transparent" MouseLeftButtonDown="OnBookMouseDown" MouseMove="OnBookMouseMove"
                               MouseLeftButtonUp="OnBookClick" LostMouseCapture="OnBookLostCapture"/>
            <TextBlock x:Name="LoadingText" Text="Abriendo el manual…" FontSize="18" Foreground="#A9B1BD"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>

        <StackPanel Grid.Row="2" HorizontalAlignment="Center" Margin="0,0,0,34">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="PreviousButton" Style="{StaticResource PillButton}" Content="◀  Anterior" Click="OnPreviousClick"/>
                <TextBlock x:Name="PageText" FontSize="16" Foreground="White" VerticalAlignment="Center" Margin="22,0" MinWidth="150" TextAlignment="Center"/>
                <Button x:Name="NextButton" Style="{StaticResource PillButton}" Content="Siguiente  ▶" Click="OnNextClick"/>
                <!-- Girar la página (solo en una sola página) -->
                <Button x:Name="RotateButton" Style="{StaticResource PillButton}" Content="⟳  Girar" Margin="14,0,0,0" Click="OnRotateClick"
                        ToolTip="Gira esta página un cuarto de vuelta (R); se recuerda"/>
                <!-- Zoom: para leer bien en pantallas pequeñas -->
                <Border Width="1" Height="26" Background="#33FFFFFF" Margin="26,0,22,0" VerticalAlignment="Center"/>
                <Button Style="{StaticResource PillButton}" Content="−" MinWidth="44" Click="OnZoomOutClick" ToolTip="Alejar (−, o Ctrl + rueda)"/>
                <TextBlock x:Name="ZoomText" FontSize="16" Foreground="White" VerticalAlignment="Center" Margin="12,0" MinWidth="60" TextAlignment="Center"/>
                <Button Style="{StaticResource PillButton}" Content="+" MinWidth="44" Click="OnZoomInClick" ToolTip="Acercar (+, o Ctrl + rueda)"/>
                <Button x:Name="FitButton" Style="{StaticResource PillButton}" Content="Ajustar" Margin="10,0,0,0" Click="OnFitClick" ToolTip="El libro entero (0)"/>
            </StackPanel>
            <TextBlock x:Name="HintText" FontSize="14" Foreground="#8C95A3" HorizontalAlignment="Center" Margin="0,12,0,0"/>
        </StackPanel>
    </Grid>
</UserControl>
