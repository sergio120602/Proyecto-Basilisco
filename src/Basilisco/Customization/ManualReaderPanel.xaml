<UserControl x:Class="Basilisco.Customization.ManualReaderPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:carousel="clr-namespace:Basilisco.Carousel"
             Focusable="True" FocusVisualStyle="{x:Null}" PreviewKeyDown="OnPreviewKeyDown" MouseWheel="OnMouseWheel">
    <!-- El manual abierto como un libro en 3D: dos páginas a la vez (la portada sola, a la derecha) y la hoja pasando -->
    <Grid Background="#F70B0D11">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Margin="56,34,56,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="ExternalButton" Style="{StaticResource PillButton}" Content="Abrir en el visor de PDF" Click="OnOpenExternalClick"
                        ToolTip="Abre el manual con el programa de PDF de Windows (para imprimirlo, buscar o ampliar)"/>
                <Button Style="{StaticResource PillButton}" Content="Cerrar" Margin="10,0,0,0" Click="OnCloseClick"/>
            </StackPanel>
            <StackPanel>
                <TextBlock x:Name="TitleText" FontSize="28" FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="Manual de instrucciones" FontSize="14" Foreground="#A9B1BD" Margin="2,4,0,0"/>
            </StackPanel>
        </DockPanel>

        <!-- El libro en 3D: un clic en la mitad derecha pasa página; en la izquierda, vuelve -->
        <Grid Grid.Row="1" Margin="40,8,40,8">
            <carousel:BookView x:Name="Book" Cursor="Hand" MouseLeftButtonUp="OnBookClick"/>
            <TextBlock x:Name="LoadingText" Text="Abriendo el manual…" FontSize="18" Foreground="#A9B1BD"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>

        <StackPanel Grid.Row="2" HorizontalAlignment="Center" Margin="0,0,0,34">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="PreviousButton" Style="{StaticResource PillButton}" Content="◀  Anterior" Click="OnPreviousClick"/>
                <TextBlock x:Name="PageText" FontSize="16" Foreground="White" VerticalAlignment="Center" Margin="22,0" MinWidth="150" TextAlignment="Center"/>
                <Button x:Name="NextButton" Style="{StaticResource PillButton}" Content="Siguiente  ▶" Click="OnNextClick"/>
            </StackPanel>
            <TextBlock x:Name="HintText" FontSize="14" Foreground="#8C95A3" HorizontalAlignment="Center" Margin="0,12,0,0"/>
        </StackPanel>
    </Grid>
</UserControl>
