<UserControl x:Class="Basilisco.Customization.CustomizePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Basilisco.Customization"
             PreviewKeyDown="OnPreviewKeyDown" SizeChanged="OnSizeChanged">
    <!-- El fondo oscurece el carrusel y bloquea los clics mientras el menú está abierto -->
    <Grid Background="#A60E1218" MouseLeftButtonDown="OnBackdropMouseDown">
        <Border Background="{DynamicResource CardBrush}" CornerRadius="20" Padding="36" HorizontalAlignment="Center" VerticalAlignment="Center"
                MouseLeftButtonDown="OnCardMouseDown">
            <Border.Effect>
                <DropShadowEffect BlurRadius="40" ShadowDepth="6" Direction="270" Opacity="0.35"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="340"/>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="420"/>
                </Grid.ColumnDefinitions>

                <!-- Vista previa: la misma caja 3D que se verá en el carrusel; se gira arrastrando -->
                <ScrollViewer x:Name="LeftScroll" VerticalScrollBarVisibility="Auto" Focusable="False">
                <StackPanel Margin="0,0,6,0">
                    <Border CornerRadius="14" ClipToBounds="True">
                        <Border.Background>
                            <DynamicResource ResourceKey="PreviewBrush"/>
                        </Border.Background>
                        <Grid Width="340" Height="340" Cursor="SizeAll">
                            <!-- El fondo del juego detrás de la caja, para ver cómo queda -->
                            <Image x:Name="PreviewBackground" Stretch="UniformToFill" IsHitTestVisible="False"/>
                            <MediaElement x:Name="PreviewVideo" Stretch="UniformToFill" IsMuted="True" LoadedBehavior="Manual"
                                          IsHitTestVisible="False" MediaEnded="OnPreviewVideoEnded"/>
                            <Viewport3D x:Name="PreviewViewport"/>
                        </Grid>
                    </Border>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
                        <Button Style="{StaticResource PillButton}" Content="Portada" Click="OnShowFrontClick"/>
                        <Button Style="{StaticResource PillButton}" Content="Lomo" Margin="10,0,0,0" Click="OnShowSpineClick"/>
                        <Button Style="{StaticResource PillButton}" Content="Contraportada" Margin="10,0,0,0" Click="OnShowBackClick"/>
                    </StackPanel>
                    <TextBlock Margin="2,14,0,0" FontSize="13" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"
                               Text="Arrastra la caja para girarla y ver su grosor. Las cuadradas se llenan con carátulas de 1024 × 1024 y las rectangulares con 600 × 800. Otras medidas se ven enteras, con negro en el hueco que sobra; usa «Ajustar…» para ampliarlas."/>

                    <!-- Apariencia: fondo, color de las letras y tiempo de juego -->
                    <TextBlock Text="FONDO" Style="{StaticResource FieldLabel}" Margin="2,24,0,8"/>
                    <WrapPanel>
                        <Button Style="{StaticResource PillButton}" Content="Imagen…" Click="OnBackgroundImageClick" Margin="0,0,8,8"
                                ToolTip="Fondo estático: una imagen detrás del carrusel cuando este juego está seleccionado"/>
                        <Button Style="{StaticResource PillButton}" Content="Vídeo…" Click="OnBackgroundVideoClick" Margin="0,0,8,8"
                                ToolTip="Fondo dinámico: un vídeo en bucle y sin sonido"/>
                        <Button Style="{StaticResource PillButton}" Content="Buscar en SteamGridDB" Click="OnSearchBackgroundClick" Margin="0,0,8,8"
                                ToolTip="Fondos del juego hechos por la comunidad (los «heroes» de steamgriddb.com, de 1920 × 620 o más)"/>
                        <Button x:Name="RemoveBackgroundButton" Style="{StaticResource PillButton}" Content="Quitar" Click="OnRemoveBackgroundClick" Margin="0,0,8,8"/>
                    </WrapPanel>
                    <TextBlock x:Name="BackgroundText" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="2,0,0,0" TextTrimming="CharacterEllipsis"/>

                    <TextBlock Text="COLOR DE LAS LETRAS" Style="{StaticResource FieldLabel}" Margin="2,18,0,8"/>
                    <WrapPanel x:Name="ColorSwatches"/>
                    <DockPanel Margin="0,4,0,0">
                        <TextBlock DockPanel.Dock="Right" FontSize="12" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="10,0,0,0" Text="o un color: #RRGGBB"/>
                        <TextBox x:Name="ColorBox" Style="{StaticResource FieldTextBox}" FontSize="14" TextChanged="OnColorBoxChanged"/>
                    </DockPanel>

                    <TextBlock Text="TIEMPO DE JUEGO" Style="{StaticResource FieldLabel}" Margin="2,18,0,8"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBox x:Name="HoursBox" Style="{StaticResource FieldTextBox}" FontSize="15" Width="80"/>
                        <TextBlock Text="h" FontSize="15" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" Margin="8,0,16,0"/>
                        <TextBox x:Name="MinutesBox" Style="{StaticResource FieldTextBox}" FontSize="15" Width="64"/>
                        <TextBlock Text="min" FontSize="15" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" Margin="8,0,16,0"/>
                        <Button x:Name="ResetPlayTimeButton" Style="{StaticResource PillButton}" Content="A cero" Click="OnResetPlayTimeClick"/>
                    </StackPanel>
                    <TextBlock x:Name="PlayTimeHint" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="2,6,0,0" TextWrapping="Wrap"
                               Text="Se cuenta solo mientras juegas desde Basilisco. Se ve debajo del juego en el carrusel."/>
                </StackPanel>
                </ScrollViewer>

                <!-- Con tantas secciones, en pantallas bajas el lado derecho se desplaza -->
                <ScrollViewer x:Name="SideScroll" Grid.Column="2" VerticalScrollBarVisibility="Auto" Focusable="False">
                <StackPanel Margin="0,0,8,0">
                    <TextBlock Text="Personalizar" FontSize="28" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>

                    <TextBlock Text="UBICACIÓN" Style="{StaticResource FieldLabel}" Margin="2,22,0,8"/>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource PillButton}" Content="Cambiar ubicación…"
                                Margin="12,0,0,0" Click="OnChangeLocationClick"/>
                        <TextBlock x:Name="PathText" FontSize="12" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>
                    </DockPanel>

                    <TextBlock Text="NOMBRE" Style="{StaticResource FieldLabel}" Margin="2,26,0,8"/>
                    <TextBox x:Name="NameBox" Style="{StaticResource FieldTextBox}" TextChanged="OnNameChanged"/>

                    <TextBlock Text="FECHA DE LANZAMIENTO" Style="{StaticResource FieldLabel}" Margin="2,16,0,8"/>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" FontSize="12" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="12,0,0,0"
                                   Text="dd/mm/aaaa o solo el año · para ordenar"/>
                        <TextBox x:Name="ReleaseBox" Style="{StaticResource FieldTextBox}" FontSize="15" Width="170" HorizontalAlignment="Left"/>
                    </DockPanel>

                    <TextBlock Text="FORMATO DE LA CAJA" Style="{StaticResource FieldLabel}" Margin="2,22,0,8"/>
                    <WrapPanel>
                        <ToggleButton x:Name="SquareToggle" Style="{StaticResource FilterToggle}" Content="Cuadrada · 1024 × 1024"
                                      Click="OnSquareClick"/>
                        <ToggleButton x:Name="PortraitToggle" Style="{StaticResource FilterToggle}" Content="Rectangular · 600 × 800"
                                      Click="OnPortraitClick"/>
                    </WrapPanel>
                    <TextBlock FontSize="13" Foreground="{DynamicResource MutedBrush}" Margin="2,0,0,0" TextWrapping="Wrap"
                               Text="Cada formato guarda sus propias imágenes: al volver al otro, recuperas las que tenía."/>
                    <TextBlock x:Name="AutoFetchText" FontSize="13" FontWeight="SemiBold" Foreground="#3E6FD8" Margin="2,6,0,0"
                               TextWrapping="Wrap" Visibility="Collapsed"/>

                    <TextBlock Text="PORTADA" Style="{StaticResource FieldLabel}" Margin="2,16,0,8"/>
                    <WrapPanel>
                        <Button Style="{StaticResource PillButton}" Content="Elegir imagen…" Click="OnChooseImageClick" Margin="0,0,10,10"/>
                        <Button Style="{StaticResource PillButton}" Content="Buscar en SteamGridDB" Click="OnSearchFrontClick" Margin="0,0,10,10"
                                ToolTip="Descarga una carátula de steamgriddb.com"/>
                        <Button Style="{StaticResource PillButton}" Content="Buscar en LaunchBox" Click="OnLaunchBoxFrontClick" Margin="0,0,10,10"
                                ToolTip="Fotos reales de la caja, de varias regiones (gamesdb.launchbox-app.com)"/>
                        <Button Style="{StaticResource PillButton}" Content="Buscar en Steam Game Covers" Click="OnCoversFrontClick" Margin="0,0,10,10"
                                ToolTip="Carátulas para imprimir de steamgamecovers.com, sin clave; si es completa, rellena también el lomo y la contraportada vacíos"/>
                        <Button x:Name="FrameFrontButton" Style="{StaticResource PillButton}" Content="Ajustar…" Margin="0,0,10,10"
                                Click="OnFrameFrontClick" ToolTip="Amplía y mueve la portada para que cuadre en la caja"/>
                        <Button x:Name="RemoveImageButton" Style="{StaticResource PillButton}" Content="Quitar imagen"
                                Margin="0,0,10,10" Click="OnRemoveImageClick"/>
                    </WrapPanel>

                    <TextBlock Text="CONTRAPORTADA" Style="{StaticResource FieldLabel}" Margin="2,22,0,8"/>
                    <WrapPanel>
                        <Button Style="{StaticResource PillButton}" Content="Elegir imagen…" Click="OnChooseBackImageClick" Margin="0,0,10,10"/>
                        <Button Style="{StaticResource PillButton}" Content="Buscar en TheGamesDB" Click="OnSearchBackClick" Margin="0,0,10,10"
                                ToolTip="Descarga la parte de atrás de la caja desde thegamesdb.net"/>
                        <Button Style="{StaticResource PillButton}" Content="Buscar en LaunchBox" Click="OnLaunchBoxBackClick" Margin="0,0,10,10"
                                ToolTip="Fotos reales de la parte de atrás de la caja (gamesdb.launchbox-app.com)"/>
                        <Button Style="{StaticResource PillButton}" Content="Buscar en Steam Game Covers" Click="OnCoversBackClick" Margin="0,0,10,10"
                                ToolTip="La parte de atrás de una carátula de steamgamecovers.com"/>
                        <Button x:Name="FrameBackButton" Style="{StaticResource PillButton}" Content="Ajustar…" Margin="0,0,10,10"
                                Click="OnFrameBackClick" ToolTip="Amplía y mueve la contraportada para que cuadre en la caja"/>
                        <Button x:Name="RemoveBackImageButton" Style="{StaticResource PillButton}" Content="Quitar imagen"
                                Margin="0,0,10,10" Click="OnRemoveBackImageClick"/>
                    </WrapPanel>

                    <TextBlock Text="LOMO" Style="{StaticResource FieldLabel}" Margin="2,12,0,8"/>
                    <WrapPanel>
                        <Button Style="{StaticResource PillButton}" Content="Elegir imagen…" Click="OnChooseSpineImageClick" Margin="0,0,10,10"/>
                        <Button Style="{StaticResource PillButton}" Content="Buscar en TheGamesDB" Click="OnSearchSpineClick" Margin="0,0,10,10"
                                ToolTip="Usa un banner de thegamesdb.net, girado para que quepa en el lomo"/>
                        <Button Style="{StaticResource PillButton}" Content="Buscar en LaunchBox" Click="OnLaunchBoxSpineClick" Margin="0,0,10,10"
                                ToolTip="Fotos reales del lomo de la caja (gamesdb.launchbox-app.com)"/>
                        <Button Style="{StaticResource PillButton}" Content="Buscar en The Spine Archive" Click="OnSpineArchiveClick" Margin="0,0,10,10"
                                ToolTip="Lomos hechos por la comunidad (thespinearchive.com), sin clave"/>
                        <Button Style="{StaticResource PillButton}" Content="Buscar en Steam Game Covers" Click="OnCoversSpineClick" Margin="0,0,10,10"
                                ToolTip="El lomo de una carátula completa de steamgamecovers.com"/>
                        <Button x:Name="FrameSpineButton" Style="{StaticResource PillButton}" Content="Ajustar…" Margin="0,0,10,10"
                                Click="OnFrameSpineClick" ToolTip="Amplía y mueve la imagen para que cuadre en el lomo"/>
                        <Button x:Name="RemoveSpineImageButton" Style="{StaticResource PillButton}" Content="Quitar imagen"
                                Margin="0,0,10,10" Click="OnRemoveSpineImageClick"/>
                    </WrapPanel>
                    <TextBlock FontSize="13" Foreground="{DynamicResource MutedBrush}" Margin="2,0,0,0" TextWrapping="Wrap"
                               Text="Las imágenes horizontales se giran para leerse de arriba abajo. También puedes arrastrar una imagen a esta ventana: se pone en la cara de la caja que estés viendo."/>

                    <!-- Lo que se ve al abrir la caja: la imagen del interior, el manual a la izquierda y el disco a la derecha -->
                    <TextBlock Text="INTERIOR DE LA CAJA" Style="{StaticResource FieldLabel}" Margin="2,18,0,8"/>
                    <WrapPanel>
                        <Button Style="{StaticResource PillButton}" Content="Elegir imagen…" Click="OnChooseInsideClick" Margin="0,0,10,10"/>
                        <Button Style="{StaticResource PillButton}" Content="Buscar en SteamGridDB" Click="OnSearchInsideClick" Margin="0,0,10,10"
                                ToolTip="Fondos y carátulas de steamgriddb.com para ver dentro de la caja"/>
                        <Button x:Name="FrameInsideButton" Style="{StaticResource PillButton}" Content="Ajustar…" Margin="0,0,10,10"
                                Click="OnFrameInsideClick" ToolTip="Amplía y mueve la imagen dentro de la caja abierta"/>
                        <Button x:Name="RemoveInsideButton" Style="{StaticResource PillButton}" Content="Quitar imagen" Margin="0,0,10,10"
                                Click="OnRemoveInsideClick"/>
                    </WrapPanel>
                    <TextBlock x:Name="InsideText" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="2,0,0,0" TextWrapping="Wrap"/>

                    <TextBlock Text="DISCO O CARTUCHO" Style="{StaticResource FieldLabel}" Margin="2,18,0,8"/>
                    <WrapPanel>
                        <Button Style="{StaticResource PillButton}" Content="Elegir imagen…" Click="OnChooseDiscClick" Margin="0,0,10,10"/>
                        <Button Style="{StaticResource PillButton}" Content="Buscar en Steam Game Covers" Click="OnCoversDiscClick" Margin="0,0,10,10"
                                ToolTip="Pegatinas de disco de steamgamecovers.com, ya recortadas en redondo"/>
                        <Button Style="{StaticResource PillButton}" Content="Buscar en LaunchBox" Click="OnLaunchBoxDiscClick" Margin="0,0,10,10"
                                ToolTip="Fotos reales del disco (gamesdb.launchbox-app.com)"/>
                        <Button x:Name="FrameDiscButton" Style="{StaticResource PillButton}" Content="Ajustar…" Margin="0,0,10,10"
                                Click="OnFrameDiscClick" ToolTip="Amplía y mueve la imagen dentro del disco"/>
                        <Button x:Name="RemoveDiscButton" Style="{StaticResource PillButton}" Content="Quitar imagen" Margin="0,0,10,10"
                                Click="OnRemoveDiscClick"/>
                    </WrapPanel>
                    <TextBlock x:Name="DiscText" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="2,0,0,0" TextTrimming="CharacterEllipsis"/>

                    <!-- La banda sonora: su lista de canciones (MusicBrainz), su disco y la música que importes -->
                    <TextBlock Text="BANDA SONORA" Style="{StaticResource FieldLabel}" Margin="2,18,0,8"/>
                    <WrapPanel>
                        <Button Style="{StaticResource PillButton}" Content="Buscar banda sonora" Click="OnSearchSoundtrackClick" Margin="0,0,10,10"
                                ToolTip="La lista de canciones y la carátula de la banda sonora en MusicBrainz"/>
                        <Button Style="{StaticResource PrimaryButton}" Content="Importar música…" Click="OnImportMusicClick" Margin="0,0,10,10"
                                ToolTip="Elige tus archivos de música: los que se llamen como una canción de la lista se quedan en ella"/>
                        <Button x:Name="SoundtrackDiscButton" Style="{StaticResource PillButton}" Content="Imagen del disco…" Click="OnSoundtrackDiscClick" Margin="0,0,10,10"/>
                        <Button x:Name="FrameSoundtrackDiscButton" Style="{StaticResource PillButton}" Content="Ajustar disco…" Click="OnFrameSoundtrackDiscClick" Margin="0,0,10,10"
                                ToolTip="Amplía y mueve la imagen dentro del disco de la banda sonora"/>
                        <Button x:Name="RemoveSoundtrackButton" Style="{StaticResource PillButton}" Content="Quitar banda sonora" Click="OnRemoveSoundtrackClick" Margin="0,0,10,10"/>
                    </WrapPanel>
                    <TextBlock x:Name="SoundtrackText" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="2,0,0,0" TextWrapping="Wrap"/>

                    <TextBlock Text="MANUAL" Style="{StaticResource FieldLabel}" Margin="2,16,0,8"/>
                    <WrapPanel>
                        <Button Style="{StaticResource PillButton}" Content="Elegir imagen…" Click="OnChooseManualClick" Margin="0,0,10,10"/>
                        <Button Style="{StaticResource PillButton}" Content="Buscar en SteamGridDB" Click="OnSteamGridDbManualClick" Margin="0,0,10,10"
                                ToolTip="Las carátulas («grids») del juego en SteamGridDB, como para la portada: la que elijas hace de librito"/>
                        <Button Style="{StaticResource PillButton}" Content="Buscar en LaunchBox" Click="OnLaunchBoxManualClick" Margin="0,0,10,10"
                                ToolTip="Un póster, un fondo o la pantalla de título del juego (gamesdb.launchbox-app.com)"/>
                        <Button x:Name="FrameManualButton" Style="{StaticResource PillButton}" Content="Ajustar…" Margin="0,0,10,10"
                                Click="OnFrameManualClick" ToolTip="Amplía y mueve la imagen del librito"/>
                        <Button x:Name="RemoveManualButton" Style="{StaticResource PillButton}" Content="Quitar imagen" Margin="0,0,10,10"
                                Click="OnRemoveManualClick"/>
                    </WrapPanel>
                    <TextBlock x:Name="ManualText" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="2,0,0,0" TextTrimming="CharacterEllipsis"/>
                    <WrapPanel Margin="0,10,0,0">
                        <Button x:Name="CreateManualButton" Style="{StaticResource PillButton}" Content="Crear manual en PDF" Click="OnCreateManualClick" Margin="0,0,10,10"
                                ToolTip="Escribe el manual con la descripción, la ficha, los requisitos y las capturas de Steam y LaunchBox"/>
                        <Button Style="{StaticResource PillButton}" Content="Elegir PDF…" Click="OnChooseManualPdfClick" Margin="0,0,10,10"
                                ToolTip="Un manual tuyo en PDF (por ejemplo, el original escaneado)"/>
                        <Button Style="{StaticResource PillButton}" Content="Buscar en Vimm's Lair" Click="OnVimmClick" Margin="0,0,10,10"
                                ToolTip="Manuales originales escaneados (vimm.net/manual): se abre en el navegador para descargarlo y Basilisco lo recoge de Descargas"/>
                        <Button Style="{StaticResource PrimaryButton}" Content="Ver Pinterest" Click="OnPinterestClick" Margin="0,0,10,10"
                                ToolTip="Busca en Pinterest (#juego #artbook), elige las imágenes en orden y se guardan como el manual"/>
                        <Button x:Name="ReadManualButton" Style="{StaticResource PillButton}" Content="Leer" Click="OnReadManualClick" Margin="0,0,10,10"/>
                        <Button x:Name="RemovePinterestButton" Style="{StaticResource PillButton}" Content="Quitar manual de Pinterest" Click="OnRemovePinterestClick"
                                Margin="0,0,10,10"/>
                        <Button x:Name="RemoveManualPdfButton" Style="{StaticResource PillButton}" Content="Quitar PDF" Click="OnRemoveManualPdfClick" Margin="0,0,10,10"/>
                    </WrapPanel>
                    <TextBlock x:Name="ManualPdfText" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="2,0,0,0" TextWrapping="Wrap"/>
                    <TextBlock FontSize="13" Foreground="{DynamicResource MutedBrush}" Margin="2,6,0,0" TextWrapping="Wrap"
                               Text="Se ven al abrir la caja con Enter: el manual a la izquierda y el disco a la derecha. Al darle a Jugar, el disco gira y empieza el juego."/>

                    <TextBlock Text="CONSOLA" Style="{StaticResource FieldLabel}" Margin="2,12,0,8"/>
                    <WrapPanel x:Name="PlatformToggles"/>

                    <TextBlock Text="FILTROS" Style="{StaticResource FieldLabel}" Margin="2,14,0,8"/>
                    <WrapPanel x:Name="FilterToggles"/>
                    <TextBlock x:Name="NoFiltersText" FontSize="13" Foreground="{DynamicResource MutedBrush}" Margin="2,0,0,0" TextWrapping="Wrap"
                               Text="Aún no hay filtros. Crea uno con «+ Nuevo filtro» en la parte de arriba."/>

                    <TextBlock x:Name="ErrorText" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource ErrorBrush}" Margin="2,14,0,0"
                               TextWrapping="Wrap" Visibility="Collapsed"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,30,0,0">
                        <Button Style="{StaticResource PillButton}" Content="Cancelar" Click="OnCancelClick"/>
                        <Button Style="{StaticResource PrimaryButton}" Content="Guardar" Margin="12,0,0,0" Click="OnSaveClick"/>
                    </StackPanel>
                </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Editor de encuadre, encima de todo lo demás -->
        <local:ImageFramePanel x:Name="FrameEditor"/>
    </Grid>
</UserControl>
