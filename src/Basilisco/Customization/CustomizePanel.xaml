<UserControl x:Class="Basilisco.Customization.CustomizePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             PreviewKeyDown="OnPreviewKeyDown">
    <!-- El fondo oscurece el carrusel y bloquea los clics mientras el menú está abierto -->
    <Grid Background="#A60E1218" MouseLeftButtonDown="OnBackdropMouseDown">
        <Border Background="#F4F6F9" CornerRadius="20" Padding="36" HorizontalAlignment="Center" VerticalAlignment="Center"
                MouseLeftButtonDown="OnCardMouseDown">
            <Border.Effect>
                <DropShadowEffect BlurRadius="40" ShadowDepth="6" Direction="270" Opacity="0.35"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="340"/>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="420"/>
                </Grid.ColumnDefinitions>

                <!-- Vista previa: la misma caja 3D que se verá en el carrusel; se gira arrastrando -->
                <StackPanel>
                    <Border CornerRadius="14" ClipToBounds="True">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#CDD3DC" Offset="0"/>
                                <GradientStop Color="#E6E9EE" Offset="0.79"/>
                                <GradientStop Color="#D3D8E0" Offset="0.80"/>
                                <GradientStop Color="#E3E6EB" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid Width="340" Height="340" Cursor="SizeAll">
                            <Viewport3D x:Name="PreviewViewport"/>
                        </Grid>
                    </Border>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
                        <Button Style="{StaticResource PillButton}" Content="Ver portada" Click="OnShowFrontClick"/>
                        <Button Style="{StaticResource PillButton}" Content="Ver contraportada" Margin="10,0,0,0" Click="OnShowBackClick"/>
                    </StackPanel>
                    <TextBlock Margin="2,14,0,0" FontSize="13" Foreground="#5B6573" TextWrapping="Wrap"
                               Text="Arrastra la caja para girarla y ver su grosor. Las cajas son cuadradas: las carátulas de 1024 × 1024 las llenan enteras. Otras medidas se muestran enteras, sin deformar ni recortar, con negro en el hueco que sobra."/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Personalizar" FontSize="28" FontWeight="SemiBold" Foreground="#1B222C"/>

                    <TextBlock Text="UBICACIÓN" Style="{StaticResource FieldLabel}" Margin="2,22,0,8"/>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource PillButton}" Content="Cambiar ubicación…"
                                Margin="12,0,0,0" Click="OnChangeLocationClick"/>
                        <TextBlock x:Name="PathText" FontSize="12" Foreground="#5B6573" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>
                    </DockPanel>

                    <TextBlock Text="NOMBRE" Style="{StaticResource FieldLabel}" Margin="2,26,0,8"/>
                    <TextBox x:Name="NameBox" Style="{StaticResource FieldTextBox}" TextChanged="OnNameChanged"/>

                    <TextBlock Text="PORTADA" Style="{StaticResource FieldLabel}" Margin="2,22,0,8"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource PillButton}" Content="Elegir imagen…" Click="OnChooseImageClick"/>
                        <Button x:Name="RemoveImageButton" Style="{StaticResource PillButton}" Content="Quitar imagen"
                                Margin="12,0,0,0" Click="OnRemoveImageClick"/>
                    </StackPanel>

                    <TextBlock Text="CONTRAPORTADA" Style="{StaticResource FieldLabel}" Margin="2,22,0,8"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource PillButton}" Content="Elegir imagen…" Click="OnChooseBackImageClick"/>
                        <Button x:Name="RemoveBackImageButton" Style="{StaticResource PillButton}" Content="Quitar imagen"
                                Margin="12,0,0,0" Click="OnRemoveBackImageClick"/>
                    </StackPanel>
                    <TextBlock FontSize="13" Foreground="#5B6573" Margin="2,10,0,0" TextWrapping="Wrap"
                               Text="También puedes arrastrar una imagen a esta ventana: se pone en la cara de la caja que estés viendo."/>

                    <TextBlock Text="FILTROS" Style="{StaticResource FieldLabel}" Margin="2,22,0,8"/>
                    <WrapPanel x:Name="FilterToggles"/>
                    <TextBlock x:Name="NoFiltersText" FontSize="13" Foreground="#5B6573" Margin="2,0,0,0" TextWrapping="Wrap"
                               Text="Aún no hay filtros. Crea uno con «+ Nuevo filtro» en la parte de arriba."/>

                    <TextBlock x:Name="ErrorText" FontSize="13" FontWeight="SemiBold" Foreground="#C0392B" Margin="2,14,0,0"
                               TextWrapping="Wrap" Visibility="Collapsed"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,30,0,0">
                        <Button Style="{StaticResource PillButton}" Content="Cancelar" Click="OnCancelClick"/>
                        <Button Style="{StaticResource PrimaryButton}" Content="Guardar" Margin="12,0,0,0" Click="OnSaveClick"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
