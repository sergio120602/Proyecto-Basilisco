<UserControl x:Class="Basilisco.Customization.FormatPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True" FocusVisualStyle="{x:Null}" PreviewKeyDown="OnPreviewKeyDown">
    <!-- Cambiar el formato de la caja de uno, varios o todos los juegos a la vez -->
    <Grid Background="#A60E1218">
        <Border Background="{DynamicResource CardBrush}" CornerRadius="20" Padding="36" Width="820" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect BlurRadius="40" ShadowDepth="6" Direction="270" Opacity="0.35"/>
            </Border.Effect>
            <StackPanel>
                <TextBlock Text="Formato de las cajas" FontSize="28" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                <TextBlock FontSize="13" Foreground="{DynamicResource MutedBrush}" Margin="2,6,0,0" TextWrapping="Wrap"
                           Text="Marca los juegos y elige su formato. Cada formato guarda sus propias imágenes: si vuelves al otro, recuperas las que tenía."/>

                <TextBlock Text="FORMATO" Style="{StaticResource FieldLabel}" Margin="2,22,0,8"/>
                <WrapPanel>
                    <ToggleButton x:Name="SquareToggle" Style="{StaticResource FilterToggle}" Content="Cuadrada · 1024 × 1024" Click="OnSquareClick"/>
                    <ToggleButton x:Name="PortraitToggle" Style="{StaticResource FilterToggle}" Content="Rectangular · 600 × 800" Click="OnPortraitClick"/>
                </WrapPanel>

                <Grid Margin="0,14,0,8">
                    <TextBlock x:Name="CountText" Style="{StaticResource FieldLabel}" Margin="2,0,0,0" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource PillButton}" Content="Marcar todos" Click="OnSelectAllClick"/>
                        <Button Style="{StaticResource PillButton}" Content="Desmarcar todos" Margin="10,0,0,0" Click="OnSelectNoneClick"/>
                    </StackPanel>
                </Grid>
                <Border Background="{DynamicResource FieldBrush}" CornerRadius="12" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" Padding="6">
                    <ScrollViewer MaxHeight="340" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="GamesList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Focusable="False" Padding="10,0,0,0" Margin="10,6"
                                              VerticalContentAlignment="Center" Click="OnRowClick">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                                            <TextBlock Text="{Binding FormatText}" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="10,0,0,0"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </CheckBox>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>

                <CheckBox x:Name="AutoFetchBox" IsChecked="True" Margin="2,16,0,0" Focusable="False" FontSize="14" Foreground="{DynamicResource TextBrush}">
                    <TextBlock TextWrapping="Wrap" Text="Si el formato nuevo aún no tiene imágenes, poner una por defecto (portada de SteamGridDB y contraportada de TheGamesDB)"/>
                </CheckBox>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                    <Button Style="{StaticResource PillButton}" Content="Cancelar" Click="OnCancelClick"/>
                    <Button x:Name="ApplyButton" Style="{StaticResource PrimaryButton}" Content="Aplicar" Margin="12,0,0,0" Click="OnApplyClick"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
