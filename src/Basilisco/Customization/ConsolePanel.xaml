<UserControl x:Class="Basilisco.Customization.ConsolePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True" FocusVisualStyle="{x:Null}" PreviewKeyDown="OnPreviewKeyDown">
    <!-- La imagen de una consola en el menú de consolas, o la de un miembro en el de Steam familiar -->
    <Grid Background="#A60E1218" MouseLeftButtonDown="OnBackdropMouseDown">
        <Border Background="{DynamicResource CardBrush}" CornerRadius="20" Padding="34" Width="640" HorizontalAlignment="Center" VerticalAlignment="Center"
                MouseLeftButtonDown="OnCardMouseDown">
            <Border.Effect>
                <DropShadowEffect BlurRadius="40" ShadowDepth="6" Direction="270" Opacity="0.35"/>
            </Border.Effect>
            <StackPanel>
                <TextBlock x:Name="TitleText" FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                <TextBlock x:Name="HelpText" FontSize="13" Foreground="{DynamicResource MutedBrush}" Margin="2,6,0,0" TextWrapping="Wrap"/>

                <!-- Vista previa: como se verá en la franja negra del menú -->
                <Border Background="#0B0C0F" CornerRadius="14" BorderBrush="#E8B923" BorderThickness="3" Height="200" Margin="0,20,0,0">
                    <Grid>
                        <Image x:Name="PreviewImage" Stretch="Uniform" Margin="14"/>
                        <TextBlock x:Name="PreviewText" Foreground="White" FontSize="30" FontWeight="Bold" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                    </Grid>
                </Border>

                <WrapPanel Margin="0,18,0,0">
                    <Button x:Name="SourceButton" Style="{StaticResource PillButton}" Click="OnSourceClick" Margin="0,0,10,10"/>
                    <Button Style="{StaticResource PillButton}" Content="Elegir imagen…" Click="OnChooseClick" Margin="0,0,10,10"/>
                    <Button x:Name="RemoveButton" Style="{StaticResource PillButton}" Content="Quitar imagen" Click="OnRemoveClick" Margin="0,0,10,10"/>
                    <!-- Solo para los miembros de la familia: sus juegos con su barra de logros -->
                    <Button x:Name="AchievementsButton" Style="{StaticResource PrimaryButton}" Content="Ver sus logros" Click="OnAchievementsClick" Margin="0,0,10,10"
                            Visibility="Collapsed" ToolTip="Todos sus juegos con su progreso de logros (y comparar los que tenéis los dos)"/>
                </WrapPanel>
                <TextBlock x:Name="StatusText" FontSize="13" Foreground="{DynamicResource MutedBrush}" Margin="2,4,0,0" TextWrapping="Wrap"/>

                <Button Style="{StaticResource PrimaryButton}" Content="Hecho" HorizontalAlignment="Right" Margin="0,18,0,0" Click="OnCloseClick"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
