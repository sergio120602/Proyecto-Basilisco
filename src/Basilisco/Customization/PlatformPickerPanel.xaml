<UserControl x:Class="Basilisco.Customization.PlatformPickerPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True" FocusVisualStyle="{x:Null}" PreviewKeyDown="OnPreviewKeyDown">
    <!-- Se abre justo después de importar: cada juego elige su consola (y con ella, el borde de su caja) -->
    <Grid Background="#A60E1218">
        <Border Background="#F4F6F9" CornerRadius="20" Padding="36" Width="820" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect BlurRadius="40" ShadowDepth="6" Direction="270" Opacity="0.35"/>
            </Border.Effect>
            <StackPanel>
                <TextBlock Text="¿De qué consola son?" FontSize="28" FontWeight="SemiBold" Foreground="#1B222C"/>
                <TextBlock x:Name="SubtitleText" FontSize="13" Foreground="#5B6573" Margin="2,6,0,0" TextWrapping="Wrap"/>

                <TextBlock Text="TODOS A" Style="{StaticResource FieldLabel}" Margin="2,22,0,8"/>
                <WrapPanel x:Name="AllButtons"/>

                <TextBlock Text="UNO A UNO" Style="{StaticResource FieldLabel}" Margin="2,14,0,8"/>
                <Border Background="White" CornerRadius="12" BorderBrush="#DCE0E7" BorderThickness="1" Padding="6">
                    <ScrollViewer MaxHeight="340" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="GamesList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="10,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="220"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" Foreground="#1F2630"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        <ComboBox Grid.Column="1" ItemsSource="{Binding Options}" SelectedItem="{Binding Selected, Mode=TwoWay}"
                                                  DisplayMemberPath="Name" FontSize="14" Padding="10,5" Focusable="False"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                    <Button Style="{StaticResource PillButton}" Content="Ahora no" Click="OnSkipClick"
                            ToolTip="Se quedan sin consola; puedes elegirla luego en Personalizar (E)"/>
                    <Button Style="{StaticResource PrimaryButton}" Content="Guardar" Margin="12,0,0,0" Click="OnSaveClick"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
