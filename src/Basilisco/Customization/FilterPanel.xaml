<UserControl x:Class="Basilisco.Customization.FilterPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             PreviewKeyDown="OnPreviewKeyDown">
    <!-- El fondo oscurece el carrusel y bloquea los clics mientras el menú está abierto -->
    <Grid Background="#A60E1218" MouseLeftButtonDown="OnBackdropMouseDown">
        <Border Background="#F4F6F9" CornerRadius="20" Padding="36" HorizontalAlignment="Center" VerticalAlignment="Center"
                MouseLeftButtonDown="OnCardMouseDown">
            <Border.Effect>
                <DropShadowEffect BlurRadius="40" ShadowDepth="6" Direction="270" Opacity="0.35"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="420"/>
                </Grid.ColumnDefinitions>

                <!-- Vista previa: la imagen en grande y la pestaña tal como se verá arriba -->
                <StackPanel>
                    <Border Width="220" Height="220" CornerRadius="16" Background="#1B1F26" ClipToBounds="True">
                        <Grid>
                            <TextBlock x:Name="PreviewInitial" FontSize="96" FontWeight="SemiBold" Foreground="#6B7585"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Image x:Name="PreviewImage" Stretch="Uniform" Margin="12"/>
                        </Grid>
                    </Border>

                    <TextBlock Text="ASÍ SE VERÁ ARRIBA" Style="{StaticResource FieldLabel}" Margin="2,20,0,8"/>
                    <Border Background="#DCE0E7" CornerRadius="14" Padding="10" HorizontalAlignment="Left">
                        <Border Background="#F4F6F9" CornerRadius="19" Padding="16,7" Effect="{StaticResource PillShadow}">
                            <StackPanel Orientation="Horizontal">
                                <Image x:Name="PreviewIcon" Width="26" Height="26" Stretch="Uniform" Margin="0,0,9,0"/>
                                <TextBlock x:Name="PreviewLabel" FontSize="15" FontWeight="SemiBold" Foreground="#1F2630"
                                           VerticalAlignment="Center" MaxWidth="150" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock x:Name="HeaderText" FontSize="28" FontWeight="SemiBold" Foreground="#1B222C"/>
                    <TextBlock x:Name="SubtitleText" FontSize="13" Foreground="#5B6573" Margin="2,4,0,0" TextWrapping="Wrap"/>

                    <TextBlock Text="NOMBRE" Style="{StaticResource FieldLabel}" Margin="2,26,0,8"/>
                    <TextBox x:Name="NameBox" Style="{StaticResource FieldTextBox}" TextChanged="OnNameChanged"/>

                    <TextBlock Text="IMAGEN" Style="{StaticResource FieldLabel}" Margin="2,22,0,8"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource PillButton}" Content="Elegir imagen…" Click="OnChooseImageClick"/>
                        <Button x:Name="RemoveImageButton" Style="{StaticResource PillButton}" Content="Quitar imagen"
                                Margin="12,0,0,0" Click="OnRemoveImageClick"/>
                    </StackPanel>
                    <TextBlock FontSize="13" Foreground="#5B6573" Margin="2,10,0,0" TextWrapping="Wrap"
                               Text="También puedes arrastrar una imagen a esta ventana. Se muestra entera, sin deformarla ni recortarla."/>

                    <TextBlock x:Name="ErrorText" FontSize="13" FontWeight="SemiBold" Foreground="#C0392B" Margin="2,14,0,0"
                               TextWrapping="Wrap" Visibility="Collapsed"/>

                    <Grid Margin="0,30,0,0">
                        <Button x:Name="DeleteButton" Style="{StaticResource PillButton}" Foreground="#C0392B"
                                Content="Eliminar filtro" HorizontalAlignment="Left" Click="OnDeleteClick"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource PillButton}" Content="Cancelar" Click="OnCancelClick"/>
                            <Button Style="{StaticResource PrimaryButton}" Content="Guardar" Margin="12,0,0,0" Click="OnSaveClick"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
