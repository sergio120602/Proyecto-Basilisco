<UserControl x:Class="Basilisco.Customization.ThemePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True" FocusVisualStyle="{x:Null}" PreviewKeyDown="OnPreviewKeyDown">
    <!-- Ajustes: la apariencia general (fondo y color de letras para todos los juegos), el rendimiento y los juegos desinstalados -->
    <Grid Background="#A60E1218">
        <Border Background="{DynamicResource CardBrush}" CornerRadius="20" Padding="34" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect BlurRadius="40" ShadowDepth="6" Direction="270" Opacity="0.35"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="400"/>
                    <ColumnDefinition Width="36"/>
                    <ColumnDefinition Width="420"/>
                </Grid.ColumnDefinitions>

                <!-- Vista previa del fondo con unas letras de ejemplo -->
                <Border CornerRadius="14" ClipToBounds="True" Height="300" VerticalAlignment="Top">
                    <Border.Background>
                        <DynamicResource ResourceKey="SceneBrush"/>
                    </Border.Background>
                    <Grid>
                        <Image x:Name="PreviewImage" Stretch="UniformToFill"/>
                        <MediaElement x:Name="PreviewVideo" Stretch="UniformToFill" IsMuted="True" LoadedBehavior="Manual" MediaEnded="OnPreviewVideoEnded"/>
                        <Border x:Name="PreviewVeil" Background="#33000000" Visibility="Collapsed"/>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock x:Name="PreviewTitle" Text="Nombre del juego" FontSize="30" FontWeight="SemiBold" HorizontalAlignment="Center">
                                <TextBlock.Effect>
                                    <DropShadowEffect x:Name="PreviewGlow" Color="White" BlurRadius="10" ShadowDepth="0" Opacity="0.9"/>
                                </TextBlock.Effect>
                            </TextBlock>
                            <TextBlock x:Name="PreviewTime" Text="⏱  12 h jugadas" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Debajo de la vista previa: dónde se guardan los juegos desinstalados (comprimidos) y cuánto se comprimen -->
                <StackPanel Margin="0,324,0,0" VerticalAlignment="Top">
                    <TextBlock Text="JUEGOS DESINSTALADOS" Style="{StaticResource FieldLabel}" Margin="2,0,0,8"/>
                    <TextBlock FontSize="12" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="2,0,0,0"
                               Text="Los juegos que no son de Steam se desinstalan con el botón que hay debajo de su título: se comprimen y se guardan en esta carpeta, y al instalarlos vuelven a su sitio tal cual. Mejor en otro disco, para liberar el de los juegos."/>
                    <DockPanel Margin="0,10,0,0">
                        <Button x:Name="OpenArchiveButton" DockPanel.Dock="Right" Style="{StaticResource PillButton}" Content="Abrir" Margin="8,0,0,0"
                                Click="OnOpenArchiveClick" ToolTip="Abrir la carpeta en el Explorador"/>
                        <Button DockPanel.Dock="Right" Style="{StaticResource PillButton}" Content="Elegir carpeta…" Margin="10,0,0,0"
                                Click="OnArchiveFolderClick"/>
                        <TextBlock x:Name="ArchiveFolderText" FontSize="13" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" Margin="2,0,0,0"/>
                    </DockPanel>
                    <WrapPanel Margin="0,12,0,0">
                        <TextBlock Text="Compresión" FontSize="13" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" Margin="2,0,12,8"/>
                        <ToggleButton x:Name="CompressionFast" Style="{StaticResource FilterToggle}" Content="Rápida" Click="OnCompressionClick"
                                      ToolTip="Tarda menos en desinstalar; el archivo ocupa algo más"/>
                        <ToggleButton x:Name="CompressionNormal" Style="{StaticResource FilterToggle}" Content="Normal" Click="OnCompressionClick"/>
                        <ToggleButton x:Name="CompressionMax" Style="{StaticResource FilterToggle}" Content="Máxima" Click="OnCompressionClick"
                                      ToolTip="Ocupa lo menos posible; tarda bastante más en desinstalar"/>
                    </WrapPanel>
                    <TextBlock x:Name="ArchiveSummaryText" FontSize="12" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="2,0,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Ajustes" FontSize="28" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                    <TextBlock FontSize="13" Foreground="{DynamicResource MutedBrush}" Margin="2,6,0,0" TextWrapping="Wrap"
                               Text="La apariencia es para todos los juegos. Si un juego tiene fondo o color propios (en Personalizar), se usan los suyos."/>

                    <TextBlock Text="MODO" Style="{StaticResource FieldLabel}" Margin="2,22,0,8"/>
                    <WrapPanel>
                        <ToggleButton x:Name="LightToggle" Style="{StaticResource FilterToggle}" Content="Claro" Click="OnModeClick"/>
                        <ToggleButton x:Name="DarkToggle" Style="{StaticResource FilterToggle}" Content="Nocturno" Click="OnModeClick"/>
                        <ToggleButton x:Name="SystemToggle" Style="{StaticResource FilterToggle}" Content="Como Windows" Click="OnModeClick"
                                      ToolTip="Claro u oscuro según el modo de Windows (Configuración → Personalización → Colores)"/>
                    </WrapPanel>

                    <TextBlock Text="FONDO" Style="{StaticResource FieldLabel}" Margin="2,14,0,8"/>
                    <WrapPanel>
                        <Button Style="{StaticResource PillButton}" Content="Imagen…" Click="OnImageClick" Margin="0,0,8,8"
                                ToolTip="Fondo estático para todos los juegos"/>
                        <Button Style="{StaticResource PillButton}" Content="Vídeo…" Click="OnVideoClick" Margin="0,0,8,8"
                                ToolTip="Fondo dinámico: un vídeo en bucle y sin sonido"/>
                        <Button x:Name="RemoveButton" Style="{StaticResource PillButton}" Content="Quitar" Click="OnRemoveClick" Margin="0,0,8,8"/>
                    </WrapPanel>
                    <TextBlock x:Name="BackgroundText" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="2,0,0,0" TextTrimming="CharacterEllipsis"/>

                    <TextBlock Text="COLOR DE LAS LETRAS" Style="{StaticResource FieldLabel}" Margin="2,18,0,8"/>
                    <WrapPanel x:Name="ColorSwatches"/>
                    <DockPanel Margin="0,4,0,0">
                        <TextBlock DockPanel.Dock="Right" FontSize="12" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="10,0,0,0" Text="o un color: #RRGGBB"/>
                        <TextBox x:Name="ColorBox" Style="{StaticResource FieldTextBox}" FontSize="14" TextChanged="OnColorBoxChanged"/>
                    </DockPanel>

                    <!-- Cuánto se ve la imagen del interior de la caja abierta, en todos los juegos que no tengan la suya -->
                    <TextBlock Text="OPACIDAD DEL INTERIOR DE LA CAJA" Style="{StaticResource FieldLabel}" Margin="2,18,0,8"/>
                    <DockPanel>
                        <TextBlock x:Name="InsideOpacityText" DockPanel.Dock="Right" Width="52" FontSize="14" Foreground="{DynamicResource TextBrush}"
                                   VerticalAlignment="Center" TextAlignment="Right"/>
                        <Slider x:Name="InsideOpacitySlider" Minimum="0" Maximum="1" SmallChange="0.05" LargeChange="0.1" VerticalAlignment="Center"
                                ValueChanged="OnInsideOpacityChanged"
                                ToolTip="A la izquierda la imagen del interior se funde con el plástico de la consola; a la derecha se ve nítida"/>
                    </DockPanel>
                    <DockPanel Margin="0,6,0,0">
                        <Button x:Name="ClearOwnOpacityButton" DockPanel.Dock="Right" Style="{StaticResource PillButton}" Content="Quitar las de cada juego"
                                Margin="10,0,0,0" Click="OnClearOwnOpacityClick"/>
                        <TextBlock x:Name="OwnOpacityText" FontSize="12" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </DockPanel>

                    <!-- Rendimiento: menos calidad o sin reflejos, menos memoria; y limpiar la carpeta de datos -->
                    <TextBlock Text="RENDIMIENTO" Style="{StaticResource FieldLabel}" Margin="2,18,0,8"/>
                    <WrapPanel>
                        <TextBlock Text="Calidad de las cajas" FontSize="13" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" Margin="2,0,12,8"/>
                        <ToggleButton x:Name="QualityHigh" Style="{StaticResource FilterToggle}" Content="Alta" Click="OnQualityClick"/>
                        <ToggleButton x:Name="QualityMedium" Style="{StaticResource FilterToggle}" Content="Media" Click="OnQualityClick"/>
                        <ToggleButton x:Name="QualityLow" Style="{StaticResource FilterToggle}" Content="Baja" Click="OnQualityClick"
                                      ToolTip="Las cajas a la mitad de resolución: ocupan la cuarta parte de memoria"/>
                    </WrapPanel>
                    <WrapPanel>
                        <ToggleButton x:Name="ReflectionsToggle" Style="{StaticResource FilterToggle}" Content="Reflejos en el suelo" Click="OnPerformanceClick"/>
                        <ToggleButton x:Name="AnimatedToggle" Style="{StaticResource FilterToggle}" Content="Fondos en vídeo en movimiento" Click="OnPerformanceClick"
                                      ToolTip="Sin esto, los fondos en vídeo se quedan quietos: gastan mucho menos procesador"/>
                    </WrapPanel>
                    <DockPanel Margin="0,2,0,0">
                        <Button DockPanel.Dock="Right" Style="{StaticResource PillButton}" Content="Optimizar datos…" Margin="10,0,0,0" Click="OnOptimizeClick"
                                ToolTip="Reduce las imágenes más grandes de lo necesario y borra los archivos que ya no usa ningún juego"/>
                        <TextBlock FontSize="12" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" TextWrapping="Wrap"
                                   Text="Aligera basilisco-data: imágenes más pequeñas y sin restos."/>
                    </DockPanel>

                    <TextBlock Text="JUEGOS CON APARIENCIA PROPIA" Style="{StaticResource FieldLabel}" Margin="2,18,0,8"/>
                    <DockPanel>
                        <Button x:Name="ClearOwnButton" DockPanel.Dock="Right" Style="{StaticResource PillButton}" Content="Quitar las de cada juego"
                                Margin="10,0,0,0" Click="OnClearOwnClick"/>
                        <TextBlock x:Name="OwnText" FontSize="13" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </DockPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,28,0,0">
                        <Button Style="{StaticResource PillButton}" Content="Cancelar" Click="OnCancelClick"/>
                        <Button Style="{StaticResource PrimaryButton}" Content="Guardar" Margin="12,0,0,0" Click="OnSaveClick"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
