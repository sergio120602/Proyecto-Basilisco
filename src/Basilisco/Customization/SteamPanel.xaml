<UserControl x:Class="Basilisco.Customization.SteamPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True" FocusVisualStyle="{x:Null}" PreviewKeyDown="OnPreviewKeyDown" SizeChanged="OnSizeChanged">
    <!-- Importar la cuenta de Steam: instalados, biblioteca completa y Steam Familiar -->
    <Grid Background="#A60E1218">
        <Border Background="#F4F6F9" CornerRadius="20" Padding="34" Width="900" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect BlurRadius="40" ShadowDepth="6" Direction="270" Opacity="0.35"/>
            </Border.Effect>
            <ScrollViewer x:Name="Scroll" VerticalScrollBarVisibility="Auto" Focusable="False">
                <StackPanel Margin="0,0,8,0">
                    <TextBlock Text="Importar desde Steam" FontSize="28" FontWeight="SemiBold" Foreground="#1B222C"/>
                    <TextBlock x:Name="AccountText" FontSize="13" Foreground="#5B6573" Margin="2,6,0,0" TextWrapping="Wrap"/>

                    <!-- Paso 1: qué importar y con qué credenciales -->
                    <StackPanel x:Name="SetupView">
                        <CheckBox x:Name="InstalledBox" IsChecked="True" Margin="2,20,0,0" Focusable="False" FontSize="15" FontWeight="SemiBold" Foreground="#1F2630"
                                  Content="Juegos instalados en este PC"/>
                        <TextBlock FontSize="13" Foreground="#5B6573" Margin="26,2,0,0" TextWrapping="Wrap"
                                   Text="Se leen de tu instalación de Steam. No hace falta clave ni internet."/>

                        <CheckBox x:Name="OwnedBox" Margin="2,16,0,0" Focusable="False" FontSize="15" FontWeight="SemiBold" Foreground="#1F2630"
                                  Content="Toda mi biblioteca (también los no instalados)" Click="OnOptionsChanged"/>
                        <StackPanel x:Name="OwnedOptions" Margin="26,4,0,0">
                            <TextBlock FontSize="13" Foreground="#5B6573" TextWrapping="Wrap"
                                       Text="Con tu clave de la Web API de Steam (gratis, no caduca; tu perfil debe tener los «Detalles de juegos» públicos) o con el token de sesión de abajo, que funciona aunque el perfil sea privado."/>
                            <DockPanel Margin="0,8,0,0">
                                <Button DockPanel.Dock="Right" Style="{StaticResource PillButton}" Content="Conseguir clave" Margin="10,0,0,0" Click="OnGetKeyClick"/>
                                <TextBox x:Name="ApiKeyBox" Style="{StaticResource FieldTextBox}" FontSize="14" ToolTip="Clave de la Web API de Steam"/>
                            </DockPanel>
                        </StackPanel>

                        <CheckBox x:Name="FamilyBox" Margin="2,16,0,0" Focusable="False" FontSize="15" FontWeight="SemiBold" Foreground="#1F2630"
                                  Content="Juegos de mi Steam Familiar" Click="OnOptionsChanged"/>
                        <StackPanel x:Name="TokenOptions" Margin="26,4,0,0">
                            <TextBlock FontSize="13" Foreground="#5B6573" TextWrapping="Wrap">
                                Steam solo da la biblioteca familiar con un <Bold>token de sesión</Bold>. Pulsa «Abrir página del token» con tu sesión de Steam
                                iniciada en el navegador, copia todo lo que aparece y pégalo aquí. Dura unas 24 horas y no se guarda en ningún archivo.
                            </TextBlock>
                            <DockPanel Margin="0,8,0,0">
                                <Button DockPanel.Dock="Right" Style="{StaticResource PillButton}" Content="Abrir página del token" Margin="10,0,0,0" Click="OnGetTokenClick"/>
                                <TextBox x:Name="TokenBox" Style="{StaticResource FieldTextBox}" FontSize="14" TextChanged="OnTokenChanged"/>
                            </DockPanel>
                            <TextBlock x:Name="TokenStatus" FontSize="12" Margin="2,6,0,0" TextWrapping="Wrap"/>
                        </StackPanel>

                        <CheckBox x:Name="FamilyFilterBox" IsChecked="True" Margin="2,18,0,0" Focusable="False" FontSize="14" Foreground="#1F2630"
                                  Content="Agrupar los de la familia en un filtro «Steam Familiar»"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                            <Button Style="{StaticResource PillButton}" Content="Cancelar" Click="OnCancelClick"/>
                            <Button x:Name="LoadButton" Style="{StaticResource PrimaryButton}" Content="Buscar juegos" Margin="12,0,0,0" Click="OnLoadClick"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Paso 2: revisar lo encontrado -->
                    <StackPanel x:Name="ResultsView" Visibility="Collapsed" Margin="0,18,0,0">
                        <Grid>
                            <TextBlock x:Name="SummaryText" FontSize="15" FontWeight="SemiBold" Foreground="#1F2630" VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Style="{StaticResource PillButton}" Content="Marcar todos" Click="OnSelectAllClick"/>
                                <Button Style="{StaticResource PillButton}" Content="Desmarcar todos" Margin="10,0,0,0" Click="OnSelectNoneClick"/>
                            </StackPanel>
                        </Grid>
                        <Border Background="White" CornerRadius="12" BorderBrush="#DCE0E7" BorderThickness="1" Margin="0,14,0,0" Padding="6">
                            <ScrollViewer MaxHeight="380" VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="ResultsList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" IsEnabled="{Binding CanImport}" Focusable="False"
                                                      Padding="10,0,0,0" Margin="10,6" VerticalContentAlignment="Center">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" Foreground="#1F2630"/>
                                                    <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="#5B6573"/>
                                                </StackPanel>
                                            </CheckBox>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                            <Button Style="{StaticResource PillButton}" Content="Volver" Click="OnBackClick"/>
                            <Button Style="{StaticResource PillButton}" Content="Cancelar" Margin="12,0,0,0" Click="OnCancelClick"/>
                            <Button x:Name="ImportButton" Style="{StaticResource PrimaryButton}" Content="Importar" Margin="12,0,0,0" Click="OnImportClick"/>
                        </StackPanel>
                    </StackPanel>

                    <TextBlock x:Name="StatusText" FontSize="13" Margin="2,14,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
