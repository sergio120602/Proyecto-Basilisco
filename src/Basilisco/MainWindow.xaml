<Window x:Class="Basilisco.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:customization="clr-namespace:Basilisco.Customization"
        Title="Basilisco" Width="1280" Height="720" MinWidth="900" MinHeight="520"
        WindowStartupLocation="CenterScreen" WindowState="Maximized"
        FontFamily="Segoe UI Variable Display, Segoe UI" Background="#D3D8E0"
        AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop"
        PreviewKeyDown="OnPreviewKeyDown" MouseWheel="OnMouseWheel">

    <Window.Resources>
        <Style x:Key="KeyBadge" TargetType="Border">
            <Setter Property="Background" Value="#3E6FD8"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="Padding" Value="7,2"/>
            <Setter Property="Margin" Value="0,0,9,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="KeyBadgeText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#1F2630"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,38,0"/>
        </Style>
    </Window.Resources>

    <Grid x:Name="Root">
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#BFC6D1" Offset="0"/>
                <GradientStop Color="#DCE0E7" Offset="0.4"/>
                <GradientStop Color="#EDEFF3" Offset="0.75"/>
            </LinearGradientBrush>
        </Grid.Background>

        <!-- Suelo brillante sobre el que se reflejan las cajas -->
        <Border x:Name="Floor" IsHitTestVisible="False">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#00C2C9D3" Offset="0"/>
                    <GradientStop Color="#C2C9D3" Offset="0.12"/>
                    <GradientStop Color="#D6DAE1" Offset="0.5"/>
                    <GradientStop Color="#E3E6EB" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <Viewport3D x:Name="Viewport" ClipToBounds="False"
                    MouseLeftButtonDown="OnViewportMouseDown" MouseMove="OnViewportMouseMove"
                    MouseLeftButtonUp="OnViewportMouseUp" MouseRightButtonDown="OnViewportRightMouseDown"
                    LostMouseCapture="OnViewportLostCapture"/>

        <!-- Cabecera -->
        <Grid VerticalAlignment="Top" Margin="44,30,44,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Basilisco" FontSize="30" FontWeight="SemiBold" Foreground="#1B222C" VerticalAlignment="Center"/>
                <TextBlock x:Name="VersionText" FontSize="13" Foreground="#5B6573" Margin="10,6,0,0" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Filtros: «Todos los juegos», los del usuario y el botón para crear uno nuevo -->
            <ScrollViewer x:Name="FilterScroll" Grid.Column="1" Focusable="False" Margin="34,0,20,0" Padding="0,10"
                          HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="FilterTabs">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="Pill" CornerRadius="19" Padding="18,7" Margin="0,0,6,0" Background="Transparent"
                                    BorderThickness="1" BorderBrush="Transparent" Cursor="Hand" ToolTip="{Binding ToolTip}"
                                    MouseLeftButtonUp="OnFilterTabClick" MouseRightButtonUp="OnFilterTabRightClick">
                                <Grid>
                                    <!-- Con imagen se ve solo el logo, entero y sin deformar; el nombre queda en el tooltip -->
                                    <Image x:Name="Logo" Source="{Binding Icon}" Visibility="Collapsed"
                                           Height="40" MaxWidth="180" Stretch="Uniform"/>
                                    <TextBlock x:Name="Label" Text="{Binding Label}" FontSize="15" FontWeight="SemiBold"
                                               Foreground="#2A313C" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <Trigger SourceName="Pill" Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Pill" Property="Background" Value="#66FFFFFF"/>
                                </Trigger>
                                <DataTrigger Binding="{Binding HasLogo}" Value="True">
                                    <Setter TargetName="Logo" Property="Visibility" Value="Visible"/>
                                    <Setter TargetName="Label" Property="Visibility" Value="Collapsed"/>
                                    <Setter TargetName="Pill" Property="Padding" Value="16,4"/>
                                    <Setter TargetName="Pill" Property="CornerRadius" Value="24"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsAddButton}" Value="True">
                                    <Setter TargetName="Label" Property="Foreground" Value="#5B6573"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                    <Setter TargetName="Pill" Property="Background" Value="#F4F6F9"/>
                                    <Setter TargetName="Pill" Property="BorderBrush" Value="White"/>
                                    <Setter TargetName="Pill" Property="Effect" Value="{StaticResource PillShadow}"/>
                                    <Setter TargetName="Label" Property="Foreground" Value="#1F2630"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource PillButton}" Content="+  Importar carpeta" Click="OnImportFolderClick"
                        ToolTip="Busca todos los juegos de una carpeta (C)"/>
                <Button Style="{StaticResource PillButton}" Content="+  Importar juego" Click="OnImportClick" Margin="10,0,0,0"
                        ToolTip="Añade un ejecutable o acceso directo (I)"/>
            </StackPanel>
        </Grid>

        <!-- Título y etiquetas del juego seleccionado -->
        <StackPanel x:Name="TitlePanel" VerticalAlignment="Bottom" HorizontalAlignment="Center" IsHitTestVisible="False">
            <TextBlock x:Name="TitleText" FontSize="36" FontWeight="SemiBold" Foreground="#1B222C"
                       HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="1000">
                <TextBlock.Effect>
                    <DropShadowEffect Color="White" BlurRadius="10" ShadowDepth="0" Opacity="0.9"/>
                </TextBlock.Effect>
            </TextBlock>
            <ItemsControl x:Name="Chips" HorizontalAlignment="Center" Margin="0,12,0,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#8D97A6" CornerRadius="14" Padding="14,5" Margin="5,0">
                            <TextBlock Text="{Binding}" Foreground="White" FontSize="13" FontWeight="SemiBold"/>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <!-- Avisos breves -->
        <Border x:Name="Toast" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,100"
                Background="#E61B222C" CornerRadius="10" Padding="18,10" Opacity="0" IsHitTestVisible="False">
            <TextBlock x:Name="ToastText" Foreground="White" FontSize="15"/>
        </Border>

        <!-- Barra de controles -->
        <Grid VerticalAlignment="Bottom" Margin="44,0,44,26">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border Height="1" Background="#99FFFFFF" Margin="0,0,0,16"/>
            <StackPanel Grid.Row="1" Orientation="Horizontal">
                <Border Style="{StaticResource KeyBadge}"><TextBlock Style="{StaticResource KeyBadgeText}" Text="← →"/></Border>
                <TextBlock Style="{StaticResource HintText}" Text="Navegar"/>
                <Border Style="{StaticResource KeyBadge}"><TextBlock Style="{StaticResource KeyBadgeText}" Text="Enter"/></Border>
                <TextBlock x:Name="ActivateHint" Style="{StaticResource HintText}" Text="Jugar"/>
                <StackPanel x:Name="GameHints" Orientation="Horizontal">
                    <Border Style="{StaticResource KeyBadge}"><TextBlock Style="{StaticResource KeyBadgeText}" Text="R"/></Border>
                    <TextBlock Style="{StaticResource HintText}" Text="Girar"/>
                    <Border Style="{StaticResource KeyBadge}"><TextBlock Style="{StaticResource KeyBadgeText}" Text="E"/></Border>
                    <TextBlock Style="{StaticResource HintText}" Text="Personalizar"/>
                    <Border Style="{StaticResource KeyBadge}"><TextBlock Style="{StaticResource KeyBadgeText}" Text="Supr"/></Border>
                    <TextBlock Style="{StaticResource HintText}" Text="Quitar"/>
                </StackPanel>
                <Border Style="{StaticResource KeyBadge}"><TextBlock Style="{StaticResource KeyBadgeText}" Text="I"/></Border>
                <TextBlock Style="{StaticResource HintText}" Text="Importar"/>
                <Border Style="{StaticResource KeyBadge}"><TextBlock Style="{StaticResource KeyBadgeText}" Text="C"/></Border>
                <TextBlock Style="{StaticResource HintText}" Text="Carpeta"/>
                <Border Style="{StaticResource KeyBadge}"><TextBlock Style="{StaticResource KeyBadgeText}" Text="Tab"/></Border>
                <TextBlock Style="{StaticResource HintText}" Text="Filtro"/>
            </StackPanel>
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Border Style="{StaticResource KeyBadge}"><TextBlock Style="{StaticResource KeyBadgeText}" Text="F11"/></Border>
                <TextBlock Style="{StaticResource HintText}" Text="Pantalla completa" Margin="0"/>
            </StackPanel>
        </Grid>

        <customization:CustomizePanel x:Name="Customizer"/>
        <customization:ArtSearchPanel x:Name="ArtSearch"/>
        <customization:FilterPanel x:Name="FilterEditor"/>
        <customization:FolderImportPanel x:Name="FolderImporter"/>
    </Grid>
</Window>
