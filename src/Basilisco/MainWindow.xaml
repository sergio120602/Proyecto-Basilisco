<Window x:Class="Basilisco.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:customization="clr-namespace:Basilisco.Customization"
        Title="Basilisco" Icon="Assets/basilisco.ico" Width="1280" Height="720" MinWidth="900" MinHeight="520"
        WindowStartupLocation="CenterScreen" WindowState="Maximized" Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI Variable Display, Segoe UI" Background="{DynamicResource WindowBrush}"
        AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop"
        PreviewKeyDown="OnPreviewKeyDown" MouseWheel="OnMouseWheel">

    <Window.Resources>
        <!-- Color de las letras de la pantalla principal; cambia con el juego seleccionado si tiene uno propio -->
        <SolidColorBrush x:Key="UiText" Color="#1F2630"/>
        <Style x:Key="KeyBadge" TargetType="Border">
            <Setter Property="Background" Value="#3E6FD8"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="Padding" Value="7,2"/>
            <Setter Property="Margin" Value="0,0,9,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="KeyBadgeText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource UiText}"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,38,0"/>
        </Style>
        <!-- Pestaña de la barra de arriba: transparente, y blanca con sombra cuando está activa -->
        <Style x:Key="HeaderTab" TargetType="ToggleButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource UiText}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Pill" CornerRadius="5" Padding="14,7" Background="Transparent" BorderThickness="1" BorderBrush="Transparent">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Pill" Property="Background" Value="#66FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Pill" Property="Background" Value="{DynamicResource CardBrush}"/>
                                <Setter TargetName="Pill" Property="BorderBrush" Value="White"/>
                                <Setter TargetName="Pill" Property="Effect" Value="{StaticResource PillShadow}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="Root">
        <Grid.Background>
            <DynamicResource ResourceKey="SceneBrush"/>
        </Grid.Background>

        <!-- Fondo propio del juego seleccionado: imagen (estático) o vídeo (dinámico), con fundido al cambiar -->
        <Grid x:Name="BackgroundLayer" IsHitTestVisible="False" Opacity="0">
            <Image x:Name="BackgroundImage" Stretch="UniformToFill"/>
            <MediaElement x:Name="BackgroundVideo" Stretch="UniformToFill" IsMuted="True" LoadedBehavior="Manual"
                          MediaEnded="OnBackgroundVideoEnded" MediaFailed="OnBackgroundVideoFailed"/>
            <!-- Velo suave para que las cajas y las letras sigan destacando -->
            <Border Background="#33000000"/>
        </Grid>

        <!-- Suelo brillante sobre el que se reflejan las cajas -->
        <Border x:Name="Floor" IsHitTestVisible="False">
            <Border.Background>
                <DynamicResource ResourceKey="FloorBrush"/>
            </Border.Background>
        </Border>

        <Viewport3D x:Name="Viewport" ClipToBounds="False"
                    MouseLeftButtonDown="OnViewportMouseDown" MouseMove="OnViewportMouseMove"
                    MouseLeftButtonUp="OnViewportMouseUp" MouseRightButtonDown="OnViewportRightMouseDown"
                    LostMouseCapture="OnViewportLostCapture"/>

        <!-- Cabecera (como el resto de la interfaz, se escala con el tamaño de la ventana) -->
        <Grid x:Name="HeaderBar" VerticalAlignment="Top" Margin="44,30,44,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Basilisco" FontSize="30" FontWeight="SemiBold" Foreground="{DynamicResource UiText}" VerticalAlignment="Center"/>
                <TextBlock x:Name="VersionText" FontSize="13" Foreground="{DynamicResource MutedBrush}" Margin="10,6,0,0" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Todos los juegos y los grupos (consolas, filtros y Steam familiar), y el buscador en el hueco que quede -->
            <Grid Grid.Column="1" Margin="34,0,20,0" VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <ToggleButton x:Name="AllTab" Style="{StaticResource HeaderTab}" Click="OnAllTabClick"
                              ToolTip="Todos los juegos de la biblioteca"/>
                <ToggleButton x:Name="ConsolesTab" Style="{StaticResource HeaderTab}" Click="OnConsolesTabClick"
                              ToolTip="Ver solo los juegos de una consola"/>
                <ToggleButton x:Name="FiltersTab" Style="{StaticResource HeaderTab}" Click="OnFiltersTabClick"
                              MouseRightButtonUp="OnFiltersTabRightClick"
                              ToolTip="Ver solo los juegos de un filtro, crear filtros nuevos o editarlos"/>
                <!-- Steam familiar: los juegos de cada miembro de la familia de Steam (tú incluido) -->
                <ToggleButton x:Name="FamilyTab" Style="{StaticResource HeaderTab}" Click="OnFamilyTabClick"
                              MouseRightButtonUp="OnFamilyTabRightClick"
                              ToolTip="Ver los juegos de cada miembro de tu familia de Steam"/>
            </StackPanel>

            <!-- Buscador de juegos: al escribir salen los nombres que más se parecen; al elegir uno, el carrusel va a él -->
            <Grid Grid.Column="1" HorizontalAlignment="Right" MinWidth="150" MaxWidth="320" Margin="10,0,0,0" ToolTip="Buscar un juego por su nombre (Ctrl+F)" VerticalAlignment="Center">
                <Border x:Name="SearchField" CornerRadius="5" Background="#40000000" BorderBrush="#66FFFFFF" BorderThickness="1" Padding="10,0,8,0" Height="36">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14"
                                   Foreground="{DynamicResource UiText}" VerticalAlignment="Center" Margin="0,0,8,0" Opacity="0.85"/>
                        <Grid>
                            <TextBlock x:Name="SearchHint" Text="Buscar juego…" FontSize="15" Foreground="{DynamicResource UiText}" Opacity="0.6"
                                       VerticalAlignment="Center" IsHitTestVisible="False" TextTrimming="CharacterEllipsis"/>
                            <TextBox x:Name="SearchBox" Background="Transparent" BorderThickness="0" FontSize="15" Foreground="{DynamicResource UiText}"
                                     CaretBrush="{DynamicResource UiText}" VerticalAlignment="Center" Padding="0"
                                     TextChanged="OnSearchTextChanged" PreviewKeyDown="OnSearchKeyDown"
                                     GotKeyboardFocus="OnSearchFocusChanged" LostKeyboardFocus="OnSearchFocusChanged"/>
                        </Grid>
                    </DockPanel>
                </Border>
                <Popup x:Name="SearchPopup" PlacementTarget="{Binding ElementName=SearchField}" Placement="Bottom" VerticalOffset="6"
                       StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                    <Border x:Name="SearchPopupCard" Background="{DynamicResource CardBrush}" CornerRadius="8" Padding="6" MinWidth="320">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Direction="270" Opacity="0.35"/>
                        </Border.Effect>
                        <StackPanel>
                            <ListBox x:Name="SearchResults" Background="Transparent" BorderThickness="0" Focusable="False"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" MaxHeight="420"
                                     PreviewMouseLeftButtonUp="OnSearchResultClick">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Focusable" Value="False"/>
                                        <Setter Property="Cursor" Value="Hand"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="Row" CornerRadius="5" Padding="12,8" Background="Transparent">
                                                        <ContentPresenter/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Row" Property="Background" Value="#22808080"/>
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="Row" Property="Background" Value="#3E6FD8"/>
                                                            <Setter Property="Foreground" Value="White"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Detail}" FontSize="12" Opacity="0.7" Margin="14,0,0,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        </DockPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock x:Name="SearchEmpty" Text="No hay ningún juego con un nombre parecido" FontSize="14" Margin="12,8"
                                       Foreground="{DynamicResource MutedBrush}" Visibility="Collapsed"/>
                        </StackPanel>
                    </Border>
                </Popup>
            </Grid>
            </Grid>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- El orden, a la derecha con el resto de opciones -->
                <ToggleButton x:Name="SortTab" Style="{StaticResource HeaderTab}" Click="OnSortTabClick"
                              ToolTip="Cambiar el orden de los juegos"/>
                <Border Width="1" Height="24" Background="#55FFFFFF" Margin="4,0,16,0" VerticalAlignment="Center"/>
                <!-- Solo aparece cuando hay una versión nueva en GitHub -->
                <Button x:Name="UpdateButton" Style="{StaticResource PrimaryButton}" Margin="0,0,10,0" Visibility="Collapsed"
                        Click="OnUpdateClick"/>
                <Button x:Name="NightButton" Style="{StaticResource PillButton}" Click="OnNightClick" Margin="0,0,10,0" MinWidth="46"
                        FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontWeight="Normal"
                        ToolTip="Modo nocturno (N)"/>
                <Button Style="{StaticResource PillButton}" Content="Apariencia" Click="OnThemeClick" Margin="0,0,10,0"
                        ToolTip="Fondo (imagen o vídeo) y color de las letras para todos los juegos (A)"/>
                <Button Style="{StaticResource PillButton}" Content="Importación Juegos NO PC" Click="OnSteamClick" Margin="0,0,10,0"
                        ToolTip="Importa de Steam, Epic Games, GOG, EA, Battle.net y de los emuladores: DuckStation, PCSX2, RPCS3, shadPS4, KytyPS5, PPSSPP, Xemu, Xenia, RetroArch, Dolphin, Cemu y Eden (S)"/>
                <Button Style="{StaticResource PillButton}" Content="Formato" Click="OnFormatClick" Margin="0,0,10,0"
                        ToolTip="Cambia el formato de las cajas (cuadrada o rectangular) de uno, varios o todos los juegos (F)"/>
                <Button Style="{StaticResource PillButton}" Content="+  Importar carpeta" Click="OnImportFolderClick"
                        ToolTip="Busca todos los juegos de una carpeta (C)"/>
                <Button Style="{StaticResource PillButton}" Content="+  Importar juego" Click="OnImportClick" Margin="10,0,0,0"
                        ToolTip="Añade un ejecutable o acceso directo (I)"/>
            </StackPanel>
        </Grid>

        <!-- Título y etiquetas del juego seleccionado -->
        <StackPanel x:Name="TitlePanel" VerticalAlignment="Top" HorizontalAlignment="Center" IsHitTestVisible="False">
            <TextBlock x:Name="TitleText" FontSize="36" FontWeight="SemiBold" Foreground="{DynamicResource UiText}"
                       HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="1000">
                <TextBlock.Effect>
                    <DropShadowEffect Color="White" BlurRadius="10" ShadowDepth="0" Opacity="0.9"/>
                </TextBlock.Effect>
            </TextBlock>
            <ItemsControl x:Name="Chips" HorizontalAlignment="Center" Margin="0,12,0,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource ChipBrush}" CornerRadius="14" Padding="14,5" Margin="5,0">
                            <TextBlock Text="{Binding}" Foreground="White" FontSize="13" FontWeight="SemiBold"/>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <!-- Debajo de la cabecera, a los lados del título: a la izquierda la alineación y la altura del carrusel; a la
             derecha la descarga de metadatos y el zoom (se colocan en UpdateOverlayLayout) -->
        <StackPanel x:Name="CarouselControlsLeft" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top">
                <!-- Alineación de las cajas: clásica (en curva) o moderna (todas las bases en línea recta) -->
                <ToggleButton x:Name="AlignToggle" Style="{StaticResource FilterToggle}" Content="Alineación moderna" Margin="0,0,30,0"
                              VerticalAlignment="Center" Click="OnAlignClick"
                              ToolTip="Moderna: las bases de todas las cajas en línea recta. Clásica: las del fondo se ven más arriba, en curva"/>
                <!-- Altura del carrusel: a mano o automática (las cajas bajan lo justo para no pisar el nombre del juego) -->
                <TextBlock Style="{StaticResource HintText}" Text="Altura" Margin="0,0,10,0"/>
                <Slider x:Name="ShiftSlider" Width="130" VerticalAlignment="Center" Focusable="False"
                        Minimum="-0.4" Maximum="1.2" SmallChange="0.05" LargeChange="0.1" IsDirectionReversed="False"
                        ValueChanged="OnShiftChanged" ToolTip="Sube o baja las cajas"/>
                <ToggleButton x:Name="AutoShiftToggle" Style="{StaticResource FilterToggle}" Content="Auto" Margin="10,0,0,0"
                              VerticalAlignment="Center" Click="OnAutoShiftClick"
                              ToolTip="Automático: cuanto más zoom, más bajan las cajas, para que el nombre del juego nunca las pise"/>
        </StackPanel>
        <StackPanel x:Name="CarouselControlsRight" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <!-- Descarga masiva: rellena lo que les falte a los juegos (portada, contraportada, lomo, interior, disco, manual) -->
                <Button x:Name="MetadataButton" Style="{StaticResource PillButton}" Content="Descarga Metadatos Actualización" Margin="0,0,30,0"
                        VerticalAlignment="Center" Focusable="False" Click="OnMetadataClick"
                        ToolTip="Busca y pone sola la portada, contraportada, lomo, interior de la caja, disco y manual de los juegos a los que les falte"/>
                <!-- Zoom del carrusel: también Ctrl + rueda, o + / − -->
                <TextBlock Style="{StaticResource HintText}" Text="Zoom" Margin="0,0,10,0"/>
                <Slider x:Name="ZoomSlider" Width="170" VerticalAlignment="Center" Focusable="False"
                        Minimum="0.7" Maximum="1.8" SmallChange="0.05" LargeChange="0.1"
                        ValueChanged="OnZoomChanged" ToolTip="Tamaño de las cajas (Ctrl + rueda, o + / −)"/>
                <TextBlock x:Name="ZoomText" Style="{StaticResource HintText}" Width="52" TextAlignment="Right" Margin="6,0,0,0"/>
        </StackPanel>

        <!-- Atajos de teclado: debajo de «Basilisco»; abre un menú con todas las teclas (antes iban en la barra de abajo) -->
        <ToggleButton x:Name="ShortcutsButton" Style="{StaticResource HeaderTab}" Content="Atajos de teclado  ▾" FontSize="14"
                      HorizontalAlignment="Left" VerticalAlignment="Top" Click="OnShortcutsClick"
                      ToolTip="Ver las teclas (y los botones del mando) de Basilisco"/>
        <Popup x:Name="ShortcutsPopup" PlacementTarget="{Binding ElementName=ShortcutsButton}" Placement="Bottom" VerticalOffset="8"
               StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade" Closed="OnShortcutsClosed">
            <Border x:Name="ShortcutsCard" Background="#F2101318" CornerRadius="10" Padding="20,14,20,4" BorderBrush="#40FFFFFF" BorderThickness="1">
                <Border.Resources>
                    <!-- Sobre el fondo oscuro del menú, las letras siempre en blanco -->
                    <SolidColorBrush x:Key="UiText" Color="White"/>
                </Border.Resources>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="4" Direction="270" Opacity="0.4"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="ATAJOS DE TECLADO" FontSize="12" FontWeight="Bold" Foreground="#99FFFFFF" Margin="0,0,0,10"/>
                    <StackPanel x:Name="MainHints" Orientation="Horizontal" Margin="0,0,0,10">
                        <Border Style="{StaticResource KeyBadge}"><TextBlock Style="{StaticResource KeyBadgeText}" x:Name="NavKey" Text="← →"/></Border>
                        <TextBlock Style="{StaticResource HintText}" Text="Navegar"/>
                        <Border Style="{StaticResource KeyBadge}"><TextBlock Style="{StaticResource KeyBadgeText}" x:Name="ConfirmKey" Text="Enter"/></Border>
                        <TextBlock x:Name="ActivateHint" Style="{StaticResource HintText}" Text="Jugar"/>
                        <StackPanel x:Name="GameHints" Orientation="Horizontal">
                            <Border Style="{StaticResource KeyBadge}"><TextBlock Style="{StaticResource KeyBadgeText}" x:Name="RotateKey" Text="R"/></Border>
                            <TextBlock Style="{StaticResource HintText}" Text="Girar"/>
                            <Border Style="{StaticResource KeyBadge}"><TextBlock Style="{StaticResource KeyBadgeText}" x:Name="CustomizeKey" Text="E"/></Border>
                            <TextBlock Style="{StaticResource HintText}" Text="Personalizar"/>
                            <StackPanel x:Name="RemoveHint" Orientation="Horizontal">
                                <Border Style="{StaticResource KeyBadge}"><TextBlock Style="{StaticResource KeyBadgeText}" Text="Supr"/></Border>
                                <TextBlock Style="{StaticResource HintText}" Text="Quitar"/>
                            </StackPanel>
                        </StackPanel>
                        <!-- Importar se hace con teclado y ratón (abre el explorador de archivos): se oculta al usar el mando -->
                        <StackPanel x:Name="ImportHints" Orientation="Horizontal">
                            <Border Style="{StaticResource KeyBadge}"><TextBlock Style="{StaticResource KeyBadgeText}" Text="I"/></Border>
                            <TextBlock Style="{StaticResource HintText}" Text="Importar"/>
                            <Border Style="{StaticResource KeyBadge}"><TextBlock Style="{StaticResource KeyBadgeText}" Text="C"/></Border>
                            <TextBlock Style="{StaticResource HintText}" Text="Carpeta"/>
                        </StackPanel>
                    </StackPanel>
                    <!-- Segunda fila: el menú entero en una sola sería más ancho que la ventana -->
                    <StackPanel Orientation="Horizontal">
                        <Border Style="{StaticResource KeyBadge}"><TextBlock Style="{StaticResource KeyBadgeText}" x:Name="FormatKey" Text="F"/></Border>
                        <TextBlock Style="{StaticResource HintText}" Text="Formato"/>
                        <Border Style="{StaticResource KeyBadge}"><TextBlock Style="{StaticResource KeyBadgeText}" x:Name="FilterKey" Text="Tab"/></Border>
                        <TextBlock Style="{StaticResource HintText}" Text="Filtro"/>
                        <!-- Solo de teclado: con el mando se ocultan -->
                        <StackPanel x:Name="KeyboardHints" Orientation="Horizontal">
                        <Border Style="{StaticResource KeyBadge}"><TextBlock Style="{StaticResource KeyBadgeText}" Text="Ctrl+F"/></Border>
                        <TextBlock Style="{StaticResource HintText}" Text="Buscar"/>
                        <Border Style="{StaticResource KeyBadge}"><TextBlock Style="{StaticResource KeyBadgeText}" Text="S"/></Border>
                        <TextBlock Style="{StaticResource HintText}" Text="Importar"/>
                        <Border Style="{StaticResource KeyBadge}"><TextBlock Style="{StaticResource KeyBadgeText}" Text="A"/></Border>
                        <TextBlock Style="{StaticResource HintText}" Text="Apariencia"/>
                        <Border Style="{StaticResource KeyBadge}"><TextBlock Style="{StaticResource KeyBadgeText}" Text="N"/></Border>
                        <TextBlock Style="{StaticResource HintText}" Text="Modo nocturno"/>
                        </StackPanel>
                        <Border Style="{StaticResource KeyBadge}"><TextBlock Style="{StaticResource KeyBadgeText}" x:Name="FullScreenKey" Text="F11"/></Border>
                        <TextBlock Style="{StaticResource HintText}" Text="Pantalla completa" Margin="0"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Popup>

        <!-- Avisos breves -->
        <Border x:Name="Toast" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,100"
                Background="#E61B222C" CornerRadius="10" Padding="18,10" Opacity="0" IsHitTestVisible="False">
            <TextBlock x:Name="ToastText" Foreground="White" FontSize="15"/>
        </Border>

        <!-- Barra de controles -->
        <Grid x:Name="FooterBar" VerticalAlignment="Bottom" Margin="44,0,44,26">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="1" Height="1" Background="#99FFFFFF" Margin="0,0,0,16"/>
            <!-- Pistas de la estantería (orden personalizado) -->
            <StackPanel x:Name="ShelfHints" Grid.Row="2" Orientation="Horizontal" Visibility="Collapsed">
                <TextBlock Style="{StaticResource HintText}" Text="Estantería" Foreground="#3E6FD8"/>
                <Border Style="{StaticResource KeyBadge}"><TextBlock Style="{StaticResource KeyBadgeText}" Text="↑"/></Border>
                <TextBlock Style="{StaticResource HintText}" Text="Coger"/>
                <Border Style="{StaticResource KeyBadge}"><TextBlock Style="{StaticResource KeyBadgeText}" Text="← →"/></Border>
                <TextBlock x:Name="ShelfMoveHint" Style="{StaticResource HintText}" Text="Recorrer"/>
                <Border Style="{StaticResource KeyBadge}"><TextBlock Style="{StaticResource KeyBadgeText}" Text="↓"/></Border>
                <TextBlock Style="{StaticResource HintText}" Text="Soltar"/>
                <Border Style="{StaticResource KeyBadge}"><TextBlock x:Name="ShelfDoneKey" Style="{StaticResource KeyBadgeText}" Text="Esc"/></Border>
                <TextBlock Style="{StaticResource HintText}" Text="Terminar"/>
            </StackPanel>
            <!-- Logros de Steam del juego seleccionado: la barra se llena con los que tienes (dorada y con el trofeo brillando al 100 %) -->
            <Grid x:Name="AchievementsPanel" Grid.Row="2" HorizontalAlignment="Center" Width="820" Visibility="Collapsed"
                  Background="Transparent" Cursor="Hand" MouseLeftButtonUp="OnAchievementsPanelClick"
                  ToolTip="Ver todos los logros del juego">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Image x:Name="TrophyImage" Height="64" Margin="0,0,16,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"
                       Source="pack://application:,,,/Basilisco;component/Assets/trophy-gray.png" RenderTransformOrigin="0.5,0.6">
                    <Image.RenderTransform>
                        <ScaleTransform x:Name="TrophyScale"/>
                    </Image.RenderTransform>
                </Image>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <DockPanel Margin="2,0,2,6">
                        <TextBlock x:Name="AchievementsPercent" DockPanel.Dock="Right" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource UiText}"/>
                        <TextBlock x:Name="AchievementsText" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource UiText}" TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                    <Border CornerRadius="7" Height="14" Background="#55000000" BorderBrush="#40FFFFFF" BorderThickness="1" ClipToBounds="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="AchievementsFill" Width="0*"/>
                                <ColumnDefinition x:Name="AchievementsRest" Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="AchievementsBar" CornerRadius="6">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#1A44C2" Offset="0"/>
                                        <GradientStop Color="#47BFFF" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- La caja abierta, al darle a un juego: manual, disco y «Jugar» -->
        <!-- Menú de filtros: franja negra con los logotipos, bajo la barra de arriba -->
        <!-- Página de logros: entra desde abajo (la escena sube) al pulsar el trofeo -->
        <Grid x:Name="AchievementsPage" Visibility="Collapsed" Background="#F20A0D12">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="AchievementsPageShift"/>
            </Grid.RenderTransform>
            <DockPanel x:Name="AchievementsPageContent" Margin="60,36,60,24">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,18">
                    <Button DockPanel.Dock="Right" Style="{StaticResource PillButton}" Content="↑  Volver (Esc)" VerticalAlignment="Top"
                            Focusable="False" Click="OnAchievementsBackClick"/>
                    <Button x:Name="MemberGamesButton" DockPanel.Dock="Right" Style="{StaticResource PillButton}" VerticalAlignment="Top" Margin="0,0,10,0"
                            Focusable="False" Click="OnMemberGamesClick" Visibility="Collapsed"/>
                    <StackPanel>
                        <TextBlock x:Name="AchievementsPageKind" Text="LOGROS DE STEAM" FontSize="13" FontWeight="Bold" Foreground="#8FA3BF"/>
                        <TextBlock x:Name="AchievementsPageTitle" FontSize="34" FontWeight="SemiBold" Foreground="White" Margin="0,2,0,4"/>
                        <TextBlock x:Name="AchievementsPageSummary" FontSize="16" Foreground="#C9D3E0" TextWrapping="Wrap"/>
                        <!-- Perfil de trofeos (juegos sin logros de Steam): crear trofeos y conectar servicios -->
                        <WrapPanel x:Name="TrophyTools" Margin="0,14,0,0" Visibility="Collapsed">
                            <Button Style="{StaticResource PrimaryButton}" Content="+  Crear trofeo" Margin="0,0,10,8" Focusable="False" Click="OnCreateTrophyClick"/>
                            <Button Style="{StaticResource PillButton}" Content="+  Crear varios" Margin="0,0,24,8" Focusable="False" Click="OnCreateTrophiesClick"
                                    ToolTip="Varios a la vez, numerados: «1. Trofeo primero, 2. Trofeo segundo…»"/>
                            <Button Style="{StaticResource PillButton}" Content="RetroAchievements" Margin="0,0,10,8" Focusable="False" Click="OnRetroAchievementsClick"
                                    ToolTip="Los logros del juego en RetroAchievements, con tu cuenta"/>
                            <Button Style="{StaticResource PillButton}" Content="RPCS3" Margin="0,0,10,8" Focusable="False" Click="OnRpcs3Click"
                                    ToolTip="Los trofeos de PS3 que guarda el emulador RPCS3"/>
                            <Button Style="{StaticResource PillButton}" Content="PlayStation · PSN Profiles" Margin="0,0,10,8" Focusable="False" Click="OnPlayStationClick"
                                    ToolTip="Tus trofeos de PlayStation Network (los mismos que enseña PSN Profiles)"/>
                            <Button Style="{StaticResource PillButton}" Content="Logros del juego" Margin="0,0,24,8" Focusable="False" Click="OnGameAchievementsClick"
                                    ToolTip="Los logros que trae el propio juego en su carpeta (como el port de Ratchet &amp; Clank); se actualizan al desbloquearlos"/>
                            <Button x:Name="TrophySyncButton" Style="{StaticResource PillButton}" Content="Actualizar" Margin="0,0,10,8" Focusable="False" Click="OnTrophySyncClick"/>
                            <Button x:Name="TrophyUnlinkButton" Style="{StaticResource PillButton}" Content="Desvincular" Margin="0,0,24,8" Focusable="False" Click="OnTrophyUnlinkClick"/>
                            <ToggleButton x:Name="ManualActivationToggle" Style="{StaticResource FilterToggle}" Content="Activación manual" Margin="0,0,0,8"
                                          VerticalAlignment="Center" Click="OnManualActivationClick"
                                          ToolTip="Encendida: un clic en un trofeo lo da por conseguido (otro clic lo quita)"/>
                        </WrapPanel>
                    </StackPanel>
                </DockPanel>
                <!-- Formularios del perfil de trofeos (crear, conectar…); se rellenan desde el código -->
                <Border x:Name="TrophyEditor" DockPanel.Dock="Top" Visibility="Collapsed" Background="#1F2A3646" CornerRadius="12"
                        BorderBrush="#40FFFFFF" BorderThickness="1" Padding="20,16" Margin="0,0,0,12"/>
                <ScrollViewer x:Name="AchievementsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                    <StackPanel x:Name="AchievementsList"/>
                </ScrollViewer>
            </DockPanel>
        </Grid>

        <customization:FilterStripPanel x:Name="FilterStrip"/>
        <customization:OpenCasePanel x:Name="CaseView"/>
        <customization:CustomizePanel x:Name="Customizer"/>
        <customization:FilterPanel x:Name="FilterEditor"/>
        <customization:FolderImportPanel x:Name="FolderImporter"/>
        <customization:PlatformPickerPanel x:Name="PlatformPicker"/>
        <customization:FormatPanel x:Name="FormatEditor"/>
        <customization:SteamPanel x:Name="SteamImporter"/>
        <customization:LauncherImportPanel x:Name="LauncherImporter"/>
        <customization:ThemePanel x:Name="ThemeEditor"/>
        <customization:ConsolePanel x:Name="ConsoleEditor"/>
        <!-- El buscador de imágenes se abre encima de Personalizar y del editor de filtros -->
        <customization:ArtSearchPanel x:Name="ArtSearch"/>
        <!-- El lector de manuales va encima de todo: se abre desde la caja abierta y desde Personalizar -->
        <customization:ManualReaderPanel x:Name="ManualReader"/>
        <!-- Pinterest, encima incluso del lector (desde él se puede rehacer el manual) -->
        <customization:PinterestPanel x:Name="PinterestPicker"/>
    </Grid>
</Window>
