<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Windows 10 (2004) o posterior: hace falta para convertir vídeos de fondo con el conversor de Windows. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Basilisco</RootNamespace>
    <AssemblyName>Basilisco</AssemblyName>
    <!-- SDL3 (mandos de Xbox, PS5 y Switch Pro) se usa con punteros. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- Logo: icono del .exe, de la ventana y de la barra de tareas. -->
    <ApplicationIcon>Assets\basilisco.ico</ApplicationIcon>

    <Version>0.5.1</Version>
    <Product>Proyecto Basilisco</Product>
    <Description>Launcher de videojuegos portable</Description>

    <!-- Portable: un único .exe autocontenido, sin instalación ni runtime de .NET. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <!-- Lectura de mandos con los mapeos correctos de Xbox, DualSense y Switch Pro; trae SDL3.dll. -->
    <PackageReference Include="ppy.SDL3-CS" Version="2026.1002.1" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\basilisco.ico" />
  </ItemGroup>

</Project>
